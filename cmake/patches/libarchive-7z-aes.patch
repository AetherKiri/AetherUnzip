+/* AetherUnzip 7z AES glue for libarchive. SPDX-License-Identifier: MIT */
+#ifndef ARCHIVE_7ZIP_AES_PRIVATE_H
+#define ARCHIVE_7ZIP_AES_PRIVATE_H
+
+#include <iconv.h>
+#if defined(__APPLE__)
+#include <CommonCrypto/CommonCryptor.h>
+#include <CommonCrypto/CommonDigest.h>
+typedef CCCryptorRef sevenzip_cipher;
+typedef CC_SHA256_CTX sevenzip_sha256;
+#define sevenzip_sha256_init(ctx) (CC_SHA256_Init(ctx) == 1)
+#define sevenzip_sha256_update(ctx, data, length) (CC_SHA256_Update(ctx, data, (CC_LONG)(length)) == 1)
+#define sevenzip_sha256_final(ctx, key) (CC_SHA256_Final(key, ctx) == 1)
+#else
+#include "archive_digest_private.h"
+#include <openssl/evp.h>
+typedef EVP_CIPHER_CTX *sevenzip_cipher;
+typedef archive_sha256_ctx sevenzip_sha256;
+#define sevenzip_sha256_init(ctx) (archive_sha256_init(ctx) == ARCHIVE_OK)
+#define sevenzip_sha256_update(ctx, data, length) (archive_sha256_update(ctx, data, length) == ARCHIVE_OK)
+#define sevenzip_sha256_final(ctx, key) (archive_sha256_final(ctx, key) == ARCHIVE_OK)
+#endif
+
+#define SEVENZIP_AES_BLOCK 16
+#define SEVENZIP_AES_CHUNK (32 * 1024)
+#define SEVENZIP_ENCRYPTED_HEADER_MAX (16 * 1024 * 1024)
+#define SEVENZIP_KDF_MAX_POWER 22
+#define SEVENZIP_KDF_ROUND_BUDGET (UINT64_C(1) << 24)
+
+struct sevenzip_aes {
+	sevenzip_cipher cipher;
+	unsigned char *buffer;
+	size_t pos, end;
+	int64_t packed_remaining, plain_size;
+	unsigned char key[32], salt[16];
+	unsigned power, salt_len;
+	int key_valid;
+	uint64_t rounds_used;
+	int (*cancel)(void *);
+	void *user;
+};
+
+static void
+sevenzip_password_error(struct archive_read *a)
+{
+	archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+	    "Incorrect passphrase or damaged encrypted 7-Zip content");
+}
+
+static void
+sevenzip_erase(void *bytes, size_t count)
+{
+	volatile unsigned char *out = bytes;
+	while (count--)
+		*out++ = 0;
+}
+
+static void
+sevenzip_reset_cipher(struct sevenzip_aes *aes)
+{
+#if defined(__APPLE__)
+	if (aes->cipher)
+		CCCryptorRelease(aes->cipher);
+#else
+	EVP_CIPHER_CTX_free(aes->cipher);
+#endif
+	aes->cipher = NULL;
+	aes->pos = aes->end = 0;
+}
+
+static void
+sevenzip_free_aes(struct sevenzip_aes *aes)
+{
+	sevenzip_reset_cipher(aes);
+	if (aes->buffer)
+		sevenzip_erase(aes->buffer, SEVENZIP_AES_CHUNK + SEVENZIP_AES_BLOCK);
+	free(aes->buffer);
+	sevenzip_erase(aes->key, sizeof(aes->key));
+}
+
+static int
+sevenzip_init_cipher(struct sevenzip_aes *aes, const unsigned char iv[16])
+{
+#if defined(__APPLE__)
+	return CCCryptorCreate(kCCDecrypt, kCCAlgorithmAES, 0, aes->key,
+	    sizeof(aes->key), iv, &aes->cipher) == kCCSuccess;
+#else
+	aes->cipher = EVP_CIPHER_CTX_new();
+	return aes->cipher && EVP_DecryptInit_ex(aes->cipher, EVP_aes_256_cbc(),
+	    NULL, aes->key, iv) && EVP_CIPHER_CTX_set_padding(aes->cipher, 0);
+#endif
+}
+
+static int
+sevenzip_decrypt(struct sevenzip_aes *aes, const void *input, size_t length)
+{
+#if defined(__APPLE__)
+	size_t produced = 0;
+	return CCCryptorUpdate(aes->cipher, input, length, aes->buffer,
+	    SEVENZIP_AES_CHUNK + SEVENZIP_AES_BLOCK, &produced) == kCCSuccess &&
+	    produced == length;
+#else
+	int produced = 0;
+	return EVP_DecryptUpdate(aes->cipher, aes->buffer, &produced, input,
+	    (int)length) && (size_t)produced == length;
+#endif
+}
+
+static int
+sevenzip_derive_key(struct archive_read *a, struct sevenzip_aes *aes,
+    unsigned power, const unsigned char *salt, unsigned salt_len)
+{
+	if (aes->key_valid && aes->power == power && aes->salt_len == salt_len &&
+	    !memcmp(aes->salt, salt, salt_len))
+		return ARCHIVE_OK;
+
+	__archive_read_reset_passphrase(a);
+	const char *password = __archive_read_next_passphrase(a);
+	if (!password) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "Passphrase required for 7-Zip AES");
+		return ARCHIVE_FAILED;
+	}
+	if (power > SEVENZIP_KDF_MAX_POWER && power != 63) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "7-Zip key derivation limit exceeded");
+		return ARCHIVE_FAILED;
+	}
+	uint64_t rounds = power == 63 ? 0 : UINT64_C(1) << power;
+	if (rounds > SEVENZIP_KDF_ROUND_BUDGET - aes->rounds_used) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "7-Zip key derivation limit exceeded");
+		return ARCHIVE_FAILED;
+	}
+	aes->rounds_used += rounds;
+
+	unsigned char material[16 + 2048 + 8];
+	size_t input_left = strlen(password), output_left = 2048;
+	if (input_left > 1024) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "7-Zip password exceeds the supported length");
+		return ARCHIVE_FAILED;
+	}
+	iconv_t converter = iconv_open("UTF-16LE", "UTF-8");
+	if (converter == (iconv_t)-1) {
+		archive_set_error(&a->archive, errno, "Cannot convert 7-Zip password");
+		return ARCHIVE_FAILED;
+	}
+	memcpy(material, salt, salt_len);
+	char *input = (char *)(uintptr_t)password;
+	char *out = (char *)material + salt_len;
+	size_t converted = iconv(converter, &input, &input_left, &out, &output_left);
+	iconv_close(converter);
+	int status = ARCHIVE_FAILED;
+	if (converted == (size_t)-1 || input_left) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "Cannot convert 7-Zip password");
+		goto done;
+	}
+	size_t prefix_len = salt_len + 2048 - output_left;
+	aes->key_valid = 0;
+	if (power == 63) {
+		memset(aes->key, 0, sizeof(aes->key));
+		memcpy(aes->key, material,
+		    prefix_len < sizeof(aes->key) ? prefix_len : sizeof(aes->key));
+	} else {
+		sevenzip_sha256 hash;
+		if (!sevenzip_sha256_init(&hash)) {
+			archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC, "Cannot initialize 7-Zip SHA-256");
+			goto done;
+		}
+		for (uint64_t i = 0; i < rounds; i++) {
+			if (!(i & 0x3fff) && aes->cancel && aes->cancel(aes->user)) {
+				(void)sevenzip_sha256_final(&hash, aes->key);
+				sevenzip_erase(aes->key, sizeof(aes->key));
+				archive_set_error(&a->archive, EINTR, "7-Zip decryption cancelled");
+				goto done;
+			}
+			archive_le64enc(material + prefix_len, i);
+			if (!sevenzip_sha256_update(&hash, material, prefix_len + 8)) {
+				(void)sevenzip_sha256_final(&hash, aes->key);
+				sevenzip_erase(aes->key, sizeof(aes->key));
+				archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+				    "Cannot update 7-Zip SHA-256");
+				goto done;
+			}
+		}
+		if (!sevenzip_sha256_final(&hash, aes->key)) {
+			sevenzip_erase(aes->key, sizeof(aes->key));
+			archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC, "Cannot finish 7-Zip SHA-256");
+			goto done;
+		}
+	}
+	aes->key_valid = 1;
+	aes->power = power;
+	aes->salt_len = salt_len;
+	memcpy(aes->salt, salt, salt_len);
+	status = ARCHIVE_OK;
+done:
+	sevenzip_erase(material, sizeof(material));
+	return status;
+}
+
+static int
+sevenzip_open_aes(struct archive_read *a, struct sevenzip_aes *aes,
+    const unsigned char *properties, size_t length, int64_t plain_size)
+{
+	unsigned char iv[SEVENZIP_AES_BLOCK] = {0};
+	unsigned power = 0, salt_len = 0, iv_len = 0;
+	const unsigned char empty = 0;
+	const unsigned char *salt = &empty;
+	if (length) {
+		power = properties[0] & 63;
+		if (properties[0] & 0xc0) {
+			if (length < 2)
+				goto invalid;
+			salt_len = ((properties[0] >> 7) & 1) + (properties[1] >> 4);
+			iv_len = ((properties[0] >> 6) & 1) + (properties[1] & 15);
+			if (length != 2 + salt_len + iv_len)
+				goto invalid;
+			salt = properties + 2;
+			memcpy(iv, salt + salt_len, iv_len);
+		} else if (length != 1)
+			goto invalid;
+	}
+	if (plain_size < 0)
+		goto invalid;
+	if (sevenzip_derive_key(a, aes, power, salt, salt_len) != ARCHIVE_OK)
+		return ARCHIVE_FAILED;
+	if (!aes->buffer) {
+		aes->buffer = malloc(SEVENZIP_AES_CHUNK + SEVENZIP_AES_BLOCK);
+		if (!aes->buffer) {
+			archive_set_error(&a->archive, ENOMEM, "Cannot allocate 7-Zip AES buffer");
+			return ARCHIVE_FATAL;
+		}
+	}
+	if (!sevenzip_init_cipher(aes, iv)) {
+		sevenzip_reset_cipher(aes);
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC, "Cannot initialize 7-Zip AES");
+		return ARCHIVE_FATAL;
+	}
+	aes->plain_size = plain_size;
+	return ARCHIVE_OK;
+invalid:
+	archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT, "Invalid 7-Zip AES properties");
+	return ARCHIVE_FATAL;
+}
+#endif
