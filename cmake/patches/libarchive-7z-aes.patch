+/* The supported AES layout is one packed stream through AES, then an
+ * optional compressor and filter. Multi-input graphs require a separate path. */
+static int
+sevenzip_aes_folder_supported(const struct _7z_folder *folder)
+{
+	size_t n = folder->numCoders;
+	if (n > 3 || folder->numPackedStreams != 1 ||
+	    folder->numInStreams != n || folder->numOutStreams != n)
+		return 0;
+	for (size_t i = 0; i < n; i++) {
+		if (folder->coders[i].numInStreams != 1 ||
+		    folder->coders[i].numOutStreams != 1)
+			return 0;
+	}
+	for (size_t i = 0; i < folder->numBindPairs; i++) {
+		if (folder->bindPairs[i].inIndex != folder->bindPairs[i].outIndex + 1)
+			return 0;
+	}
+	if (n > 1 && folder->coders[1].codec != _7Z_COPY &&
+	    folder->coders[1].codec != _7Z_LZMA &&
+	    folder->coders[1].codec != _7Z_LZMA2)
+		return 0;
+	if (n > 2 && compressor_name(folder->coders[2].codec) != NULL)
+		return 0;
+	return 1;
 }
 
