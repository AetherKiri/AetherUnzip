+/* Consume aligned ciphertext once, and keep partially used plaintext for
+ * the next decoder call. The pack stream tracks its logical, unpadded size. */
+static const void *
+sevenzip_plain_input(struct archive_read *a, struct _7zip *zip, ssize_t *available)
+{
+	struct sevenzip_aes *aes = &zip->aes;
+	if (aes->pos == aes->end && aes->packed_remaining > 0) {
+		size_t length = aes->packed_remaining < SEVENZIP_AES_CHUNK ?
+		    (size_t)aes->packed_remaining : SEVENZIP_AES_CHUNK;
+		const void *input = __archive_read_ahead(a, length, NULL);
+		if (!input || !sevenzip_decrypt(aes, input, length) ||
+		    __archive_read_consume(a, length) != (int64_t)length) {
+			archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+			    "Truncated or unreadable 7-Zip AES stream");
+			return NULL;
+		}
+		aes->packed_remaining -= length;
+		zip->stream_offset += length;
+		aes->pos = 0;
+		aes->end = zip->pack_stream_inbytes_remaining < (int64_t)length ?
+		    (size_t)zip->pack_stream_inbytes_remaining : length;
+	}
+	*available = (ssize_t)(aes->end - aes->pos);
+	return aes->buffer + aes->pos;
+}
