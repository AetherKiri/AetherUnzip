+void
+aether_archive_read_rar5_cancel(struct archive *handle, int (*cancel)(void *), void *user)
+{
+	struct archive_read *a = (struct archive_read *)handle;
+	for (size_t i = 0; i < sizeof(a->formats) / sizeof(a->formats[0]); i++) {
+		if (a->formats[i].bid == rar5_bid) {
+			struct rar5 *rar5 = a->formats[i].data;
+			rar5->header_crypto.cancel = rar5->file_crypto.cancel = cancel;
+			rar5->header_crypto.user = rar5->file_crypto.user = user;
+			return;
+		}
+	}
+}
+
+int
+aether_archive_read_rar5_can_skip(struct archive *handle, int catalog_only,
+    int has_passphrase)
+{
+	struct archive_read *a = (struct archive_read *)handle;
+	if (!a->format || a->format->bid != rar5_bid)
+		return 0;
+	struct rar5 *rar5 = a->format->data;
+	return catalog_only || !rar5->main.solid ||
+	    (!rar5->file.bytes_remaining && !rar5->cstate.initialized) ||
+	    rar5->file.service || rar5->file.dir || rar5->cstate.method == 0 ||
+	    (!has_passphrase && (rar5->file.crypto.state || rar5->solid_history_missing));
+}
+
+int
+aether_archive_read_rar5_skip_raw(struct archive *handle)
+{
+	struct archive_read *a = (struct archive_read *)handle;
+	struct rar5 *rar5 = a->format->data;
+	rar5->raw_skip = 1;
+	int status = archive_read_data_skip(handle);
+	rar5->raw_skip = 0;
+	return status;
+}
