+static int
+rar5_record_vint(const uint8_t **bytes, size_t *length, uint64_t *value)
+{
+	*value = 0;
+	for (unsigned i = 0; i < 10 && *length; i++) {
+		uint8_t byte = *(*bytes)++;
+		--*length;
+		if (i == 9 && byte > 1)
+			return 0;
+		*value |= (uint64_t)(byte & 127) << (7 * i);
+		if (!(byte & 128))
+			return 1;
+	}
+	return 0;
+}
+
+static int
+rar5_parse_crypto(const uint8_t *p, size_t length, int header,
+    struct rar5_crypto_record *record)
+{
+	uint64_t version, flags;
+	if (!rar5_record_vint(&p, &length, &version) ||
+	    !rar5_record_vint(&p, &length, &flags))
+		return 0;
+	if (version || (flags & ~(uint64_t)(header ? 1 : 3))) {
+		record->state = -1;
+		return 1;
+	}
+	size_t fixed = 17 + (header ? 0 : 16);
+	if (length != fixed + ((flags & 1) ? 12 : 0))
+		return 0;
+	record->state = 1;
+	record->has_check = (flags & 1) != 0;
+	record->hash_mac = (flags & 2) != 0;
+	record->power = p[0];
+	memcpy(record->salt, p + 1, 16);
+	if (!header)
+		memcpy(record->iv, p + 17, 16);
+	if (record->has_check)
+		memcpy(record->check, p + fixed, 12);
+	return 1;
 }
 
