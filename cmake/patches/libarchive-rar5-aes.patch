 int archive_read_support_format_rar5(struct archive *_a) {
 	struct archive_read* ar = (struct archive_read*)_a;
 	struct rar5 *rar5;
--- /dev/null
+++ b/libarchive/archive_rar5_aes_private.h
@@ -0,0 +1,252 @@
+/* RAR 5.0 encryption framing and platform crypto glue. SPDX-License-Identifier: MIT */
+#ifndef ARCHIVE_RAR5_AES_PRIVATE_H
+#define ARCHIVE_RAR5_AES_PRIVATE_H
+
+#if defined(__APPLE__)
+#include <CommonCrypto/CommonCryptor.h>
+#include <CommonCrypto/CommonDigest.h>
+#include <CommonCrypto/CommonHMAC.h>
+typedef CCCryptorRef rar5_cipher;
+#else
+#include <openssl/evp.h>
+#include <openssl/hmac.h>
+typedef EVP_CIPHER_CTX *rar5_cipher;
+#endif
+
+#define RAR5_AES_BLOCK 16
+#define RAR5_AES_BUFFER_MAX (16 * 1024 * 1024 + 32)
+#define RAR5_KDF_MAX_POWER 20
+#define RAR5_KDF_BUDGET (UINT64_C(1) << 27)
+
+struct rar5_crypto_record {
+	uint8_t salt[16], iv[16], check[12];
+	uint8_t power;
+	int has_check, hash_mac;
+	/* 0 absent, 1 supported, -1 unsupported version or flags. */
+	int state;
+};
+
+struct rar5_crypto {
+	rar5_cipher cipher;
+	uint8_t *buffer;
+	size_t capacity, position, end, raw_remaining;
+	int (*cancel)(void *);
+	void *user;
+	uint64_t rounds;
+	uint8_t aes_key[32], hash_key[32], check[8], salt[16];
+	unsigned power;
+	int key_valid, verified_password;
+};
+
+static void
+rar5_wipe(void *memory, size_t count)
+{
+	volatile uint8_t *p = memory;
+	while (count--)
+		*p++ = 0;
+}
+
+static void
+rar5_crypto_reset(struct rar5_crypto *crypto)
+{
+#if defined(__APPLE__)
+	if (crypto->cipher)
+		CCCryptorRelease(crypto->cipher);
+#else
+	EVP_CIPHER_CTX_free(crypto->cipher);
+#endif
+	crypto->cipher = NULL;
+	crypto->position = crypto->end = crypto->raw_remaining = 0;
+	crypto->verified_password = 0;
+}
+
+static int
+rar5_crypto_start(struct rar5_crypto *crypto, const uint8_t key[32],
+    const uint8_t iv[16])
+{
+#if defined(__APPLE__)
+	return CCCryptorCreate(kCCDecrypt, kCCAlgorithmAES, 0, key, 32, iv,
+	    &crypto->cipher) == kCCSuccess;
+#else
+	crypto->cipher = EVP_CIPHER_CTX_new();
+	return crypto->cipher &&
+	    EVP_DecryptInit_ex(crypto->cipher, EVP_aes_256_cbc(), NULL, key, iv) &&
+	    EVP_CIPHER_CTX_set_padding(crypto->cipher, 0);
+#endif
+}
+
+static int
+rar5_crypto_decrypt(struct rar5_crypto *crypto, const void *input, size_t length,
+    uint8_t *output, size_t capacity)
+{
+#if defined(__APPLE__)
+	size_t actual = 0;
+	return CCCryptorUpdate(crypto->cipher, input, length, output, capacity,
+	    &actual) == kCCSuccess && actual == length;
+#else
+	int actual = 0;
+	return capacity >= length && EVP_DecryptUpdate(crypto->cipher,
+	    output, &actual, input, (int)length) && (size_t)actual == length;
+#endif
+}
+
+static int
+rar5_hmac(const void *key, size_t key_size, const void *message, size_t length,
+    uint8_t output[32])
+{
+#if defined(__APPLE__)
+	CCHmac(kCCHmacAlgSHA256, key, key_size, message, length, output);
+	return 1;
+#else
+	unsigned actual = 0;
+	return HMAC(EVP_sha256(), key, (int)key_size, message, length,
+	    output, &actual) != NULL && actual == 32;
+#endif
+}
+
+static int
+rar5_check_digest(const uint8_t input[8], uint8_t output[32])
+{
+#if defined(__APPLE__)
+	return CC_SHA256(input, 8, output) != NULL;
+#else
+	unsigned actual = 0;
+	return EVP_Digest(input, 8, output, &actual, EVP_sha256(), NULL) && actual == 32;
+#endif
+}
+
+static int
+rar5_crypto_derive(struct archive_read *a, struct rar5_crypto *crypto,
+    const struct rar5_crypto_record *record)
+{
+	if (record->state != 1) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+		    "RAR5 encryption method is not supported");
+		return ARCHIVE_FAILED;
+	}
+	__archive_read_reset_passphrase(a);
+	const char *password = __archive_read_next_passphrase(a);
+	if (!password) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "Passphrase required for RAR5 AES");
+		return ARCHIVE_FAILED;
+	}
+	size_t password_size = strlen(password);
+	if (record->power > RAR5_KDF_MAX_POWER || password_size > 1024) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "RAR5 key derivation limit exceeded");
+		return ARCHIVE_FAILED;
+	}
+	if (!crypto->key_valid || crypto->power != record->power ||
+	    memcmp(crypto->salt, record->salt, sizeof(crypto->salt))) {
+		uint64_t rounds = UINT64_C(1) << record->power;
+		if (rounds + 32 > RAR5_KDF_BUDGET - crypto->rounds) {
+			archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+			    "RAR5 key derivation limit exceeded");
+			return ARCHIVE_FAILED;
+		}
+		crypto->key_valid = 0;
+		crypto->rounds += rounds + 32;
+		uint8_t seed[20] = {0};
+		uint8_t previous[32], next[32], accumulator[32];
+		memcpy(seed, record->salt, sizeof(record->salt));
+		seed[19] = 1;
+		int ok = rar5_hmac(password, password_size, seed, sizeof(seed), previous);
+		if (ok)
+			memcpy(accumulator, previous, sizeof(accumulator));
+		/* RAR uses snapshots of the same PBKDF2 block at c, c+16, c+32. */
+		for (uint64_t i = 1; ok && i <= rounds + 32; i++) {
+			if (i == rounds)
+				memcpy(crypto->aes_key, accumulator, sizeof(crypto->aes_key));
+			if (i == rounds + 16)
+				memcpy(crypto->hash_key, accumulator, sizeof(crypto->hash_key));
+			if (i == rounds + 32)
+				break;
+			if (!(i & 0xfff) && crypto->cancel && crypto->cancel(crypto->user)) {
+				archive_set_error(&a->archive, EINTR, "RAR5 decryption cancelled");
+				ok = 0;
+				break;
+			}
+			ok = rar5_hmac(password, password_size, previous, sizeof(previous), next);
+			if (ok) {
+				for (size_t j = 0; j < sizeof(accumulator); j++)
+					accumulator[j] ^= next[j];
+				memcpy(previous, next, sizeof(previous));
+			}
+		}
+		memset(crypto->check, 0, sizeof(crypto->check));
+		if (ok) {
+			for (size_t i = 0; i < sizeof(accumulator); i++)
+				crypto->check[i % sizeof(crypto->check)] ^= accumulator[i];
+			memcpy(crypto->salt, record->salt, sizeof(crypto->salt));
+			crypto->power = record->power;
+			crypto->key_valid = 1;
+		}
+		rar5_wipe(previous, sizeof(previous));
+		rar5_wipe(next, sizeof(next));
+		rar5_wipe(accumulator, sizeof(accumulator));
+		if (!ok) {
+			rar5_wipe(crypto->aes_key, sizeof(crypto->aes_key));
+			rar5_wipe(crypto->hash_key, sizeof(crypto->hash_key));
+			if (archive_errno(&a->archive) != EINTR)
+				archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+				    "Cannot derive RAR5 key");
+			return ARCHIVE_FAILED;
+		}
+	}
+	crypto->verified_password = 0;
+	if (record->has_check) {
+		uint8_t check_hash[32];
+		if (!rar5_check_digest(record->check, check_hash) ||
+		    memcmp(check_hash, record->check + 8, 4)) {
+			archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+			    "Damaged RAR5 password verification field");
+			return ARCHIVE_FAILED;
+		}
+		unsigned difference = 0;
+		for (size_t i = 0; i < sizeof(crypto->check); i++)
+			difference |= crypto->check[i] ^ record->check[i];
+		if (difference) {
+			archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+			    "Incorrect passphrase for RAR5 AES");
+			return ARCHIVE_FAILED;
+		}
+		crypto->verified_password = 1;
+	}
+	return ARCHIVE_OK;
+}
+
+static int
+rar5_crypto_reserve(struct archive_read *a, struct rar5_crypto *crypto, size_t needed)
+{
+	if (needed > RAR5_AES_BUFFER_MAX) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+		    "RAR5 AES buffer limit exceeded");
+		return 0;
+	}
+	if (crypto->capacity >= needed)
+		return 1;
+	size_t capacity = 65536;
+	while (capacity < needed && capacity <= RAR5_AES_BUFFER_MAX / 2)
+		capacity *= 2;
+	if (capacity < needed)
+		capacity = RAR5_AES_BUFFER_MAX;
+	uint8_t *buffer = realloc(crypto->buffer, capacity);
+	if (!buffer) {
+		archive_set_error(&a->archive, ENOMEM, "Cannot allocate RAR5 AES buffer");
+		return 0;
+	}
+	crypto->buffer = buffer;
+	crypto->capacity = capacity;
+	return 1;
+}
+
+static void
+rar5_crypto_destroy(struct rar5_crypto *crypto)
+{
+	rar5_crypto_reset(crypto);
+	rar5_wipe(crypto->buffer, crypto->capacity);
+	free(crypto->buffer);
+	rar5_wipe(crypto, sizeof(*crypto));
+}
+#endif
