        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遇到冲突时停止"
          }
        }
      }
    },
    "Stop when a file already exists. Files already extracted are kept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同名のファイルがあると停止します。展開済みのファイルは保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遇到同名文件时停止。已解压的文件会保留。"
          }
        }
      }
    },
    "That name is already in use in this folder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダでは、その名前はすでに使われています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹中已存在同名项目。"
          }
        }
      }
    },
    "The encryption used by these entries is unsupported.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの項目の暗号化方式には対応していません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些条目使用的加密方式不受支持。"
          }
        }
      }
    },
    "The password library could not be accessed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードライブラリにアクセスできませんでした。"
