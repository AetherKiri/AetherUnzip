    },
    "%lld will be skipped": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件をスキップします"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将跳过 %lld 个归档"
          }
        }
      }
    },
    "%llu of %llu entries processed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%llu / %llu 項目を処理済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已处理 %llu / %llu 项"
          }
        }
      }
    },
    "A password is required to extract locked entries.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックされた項目の展開にはパスワードが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解压受保护的文件需要密码。"
          }
        }
      }
    },
    "A password is required to verify this archive.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアーカイブを確認するにはパスワードが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要密码才能验证此压缩包。"
          }
        }
      }
    },
    "A to Z": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "A → Z"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "A 到 Z"
          }
        }
      }
    },
    "AES-256 for single volumes, including encrypted file names. Volume sets require unencrypted files.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単一ファイルはファイル名を含む AES-256 暗号化に対応。分割ファイルは暗号化されていないものに対応。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单卷支持 AES-256 和文件名加密。分卷支持未加密文件。"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "情報"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "About AetherUnzip": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherUnzip について"
