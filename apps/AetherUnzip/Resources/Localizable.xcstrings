    "Background time expired. %lld of %lld archives extracted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンド処理時間を使い切りました。%lld / %lld 件のアーカイブを展開しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台处理时间已用尽。已解压 %lld / %lld 个压缩包。"
          }
        }
      }
    },
    "Background time expired. Completed files are kept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンド処理時間を使い切りました。展開済みのファイルは保持されます。"
