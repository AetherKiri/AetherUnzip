    "Access to this archive has expired. Select it again with Open Archive.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアーカイブへのアクセス権が失効しました。「アーカイブを開く」から選び直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此压缩包的访问权限已失效。请通过“打开压缩包”重新选择。"
          }
        }
      }
    },
