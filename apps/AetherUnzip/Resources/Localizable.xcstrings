            "value": "単体の .zst と .tar.zst アーカイブに対応。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持独立 .zst 流和 .tar.zst 归档。"
          }
        }
      }
    },
    "Standard KiriKiri archives. Game-specific protected entries require dedicated support.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "標準の吉里吉里アーカイブに対応。ゲーム固有の保護方式には個別対応が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持标准 KiriKiri 归档。受游戏专用方案保护的条目需要单独适配。"
          }
        }
      }
    },
    "Stop on conflict": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "競合時に停止"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遇到冲突时停止"
          }
        }
      }
    },
    "Stop when a file already exists. Files already extracted are kept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同名のファイルがあると停止します。展開済みのファイルは保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遇到同名文件时停止。已解压的文件会保留。"
          }
        }
      }
    },
    "Storage": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレージ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储"
          }
        }
      }
    },
    "Suggested Name": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推奨ファイル名"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议文件名"
          }
        }
      }
    },
    "Supported": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已支持"
          }
        }
      }
    },
    "Supported Formats": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応する圧縮形式"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持的压缩格式"
          }
        }
      }
    },
    "Temporary Space Limits": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時領域の上限"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "临时空间上限"
          }
        }
      }
    },
    "That name is already in use in this folder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダでは、その名前はすでに使われています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹中已存在同名项目。"
          }
        }
      }
    },
    "The encryption used by these entries is unsupported.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの項目の暗号化方式には対応していません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些条目使用的加密方式不受支持。"
          }
        }
      }
    },
    "The file changed after identification. Identify it again before renaming.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "識別後にファイルが変更されました。名前を変更する前にもう一度識別してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "识别后文件已发生变化。请重新识别后再更名。"
          }
        }
      }
    },
    "The password library could not be accessed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードライブラリにアクセスできませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问密码库。"
          }
        }
      }
    },
    "The password library is empty.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードライブラリは空です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码库为空。"
          }
        }
      }
    },
    "The selected items will be permanently deleted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した項目は完全に削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选项目将被永久删除。"
          }
        }
      }
    },
    "The selected items will move to the Trash.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した項目はゴミ箱に移動します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选项目将移到废纸篓。"
          }
        }
      }
    },
    "These limits apply to new archive operations.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これ以降に開始するアーカイブ操作に適用されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些限制适用于之后开始的压缩包操作。"
          }
        }
      }
    },
    "Third-party Libraries": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サードパーティライブラリ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第三方库"
          }
        }
      }
    },
    "This clears recently opened archives and extraction history from the activity list.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近開いたアーカイブと展開履歴をアクティビティの一覧から消去します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从活动列表移除最近打开的压缩包和解压记录。"
          }
        }
      }
    },
    "This Folder Is Empty": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダは空です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹为空"
          }
        }
      }
    },
    "This file exceeds the preview limits.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルはプレビューの上限を超えています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件超出预览限制。"
          }
        }
      }
    },
    "This name contains a character that isn’t allowed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前に使用できない文字が含まれています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称包含不允许的字符。"
          }
        }
      }
    },
    "This password is no longer in the library.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパスワードはライブラリから削除されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此密码已从密码库移除。"
          }
        }
      }
    },
    "Total Output": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "展開データの合計"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解压总量"
          }
        }
      }
    },
    "Try Again": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度試す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再试一次"
          }
        }
      }
    },
    "Try All Saved Passwords": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのパスワードをすべて試す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试所有已保存的密码"
          }
        }
      }
    },
    "Try Saved Passwords": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのパスワードを試す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试已保存的密码"
          }
        }
      }
    },
    "Use the archive’s folder when available. Otherwise use App Documents.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可されていればアーカイブと同じフォルダを使います。それ以外はアプリ内に保存します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先使用已授权的归档所在文件夹，其余情况保存到 App 的文档目录。"
          }
        }
      }
    },
    "Uses passwords in your library for locked archives. Failed archives appear in Activity.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックされたアーカイブにパスワードライブラリを使用します。展開できなかった項目は履歴で確認できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为加密归档尝试密码库中的密码。失败的归档会显示在活动记录里。"
          }
        }
      }
    },
    "USTAR archives (.tar).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "USTAR アーカイブ（.tar）に対応。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 USTAR 归档（.tar）。"
          }
        }
      }
    },
    "Unencrypted single archives and volume sets.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化されていない単一ファイルと分割ファイルに対応。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持未加密的单卷和分卷归档。"
          }
        }
      }
    },
    "Unknown size": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズ不明"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大小未知"
          }
        }
      }
    },
    "Use a file name without slashes or a leading dot.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル名にスラッシュを含めたり、先頭にピリオドを付けたりできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件名不能包含斜杠或以点开头。"
          }
        }
      }
    },
    "Use letters, numbers, hyphens, or underscores in each extension segment.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張子の各部分には、文字、数字、ハイフン、アンダースコアを使ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后缀的每一段仅可使用字母、数字、连字符或下划线。"
          }
        }
      }
    },
    "Version %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 %@"
          }
        }
      }
    },
    "Version %@ (Build %@)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン %1$@（ビルド %2$@）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 %1$@（构建 %2$@）"
          }
        }
      }
    },
    "View Folder": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダを表示"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看文件夹"
          }
        }
      }
    },
    "View Results": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果を見る"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看结果"
          }
        }
      }
    },
    "Working": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在处理"
          }
        }
      }
    },
    "Write directly into the destination, preserving archive paths.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブ内のパスを維持して保存先に直接展開します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接写入目标文件夹，保留归档内的原始路径。"
          }
        }
      }
    },
    "XML (.xml)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "XML（.xml）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "XML（.xml）"
          }
        }
      }
    },
    "YAML (.yaml)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YAML（.yaml）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "YAML（.yaml）"
          }
        }
      }
    },
    "You may redistribute this software under GPL-3.0-only. It comes without warranty.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このソフトウェアは GPL-3.0-only の条件で再配布できます。保証はありません。"
          }
