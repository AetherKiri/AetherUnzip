        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台处理时间已用尽。已完成的文件会保留。"
          }
        }
      }
    },
    "Batch cancelled. %lld of %lld archives extracted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一括展開を中止しました。%2$lld 件中 %1$lld 件を展開しました。"
