    },
    "%lld MiB": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld MiB"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld MiB"
          }
        }
      }
    },
    "%lld of %lld archives extracted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld 件中 %1$lld 件のアーカイブを展開しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已解压 %1$lld 个归档，共 %2$lld 个。"
          }
        }
      }
    },
    "%lld parts": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld part"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld parts"
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分割"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个分卷"
          }
        }
      }
    },
    "%lld selected": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 項目を選択中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选 %lld 项"
