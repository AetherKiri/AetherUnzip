          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最小优先"
          }
        }
      }
    },
    "Some items can’t be extracted. Select the files you want to keep.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の項目は展開できません。残したいファイルを選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分项目无法解压。请选择要保留的文件。"
          }
        }
      }
    },
    "Sort By": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "並べ替え"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排序方式"
          }
        }
